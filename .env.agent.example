# Load these into your shell from your private environment/secret manager.
# The launcher reads only SOCIAL_RECIPES_* configuration.
SOCIAL_RECIPES_PROVIDER=openrouter
SOCIAL_RECIPES_MODEL=your-vision-capable-model
SOCIAL_RECIPES_API_KEY=
SOCIAL_RECIPES_STATE_DIR=/absolute/path/to/new-private-social-recipes-state
SOCIAL_RECIPES_HERMES_SOURCE=/absolute/path/to/social-recipes-hermes
SOCIAL_RECIPES_SUPABASE_URL=https://your-project.supabase.co
SOCIAL_RECIPES_SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_RECIPES_IG_APP_SECRET=
SOCIAL_RECIPES_IG_VERIFY_TOKEN=
SOCIAL_RECIPES_IG_ACCESS_TOKEN=
SOCIAL_RECIPES_IG_BUSINESS_ID=
# Supply all three for an independent OpenAI-compatible vision endpoint.
# Required with the Anthropic conversational provider.
# SOCIAL_RECIPES_VISION_BASE_URL=https://your-vision-service/v1
# SOCIAL_RECIPES_VISION_MODEL=your-vision-model
# SOCIAL_RECIPES_VISION_API_KEY=
